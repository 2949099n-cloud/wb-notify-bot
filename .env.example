# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ключ шифрования WB-токенов магазинов (обязателен). Сгенерировать один раз:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потерять этот ключ = потерять доступ ко всем сохранённым WB-токенам всех
# пользователей — хранить как секрет, не коммитить, не терять при переезде на новый сервер.
TOKEN_ENCRYPTION_KEY=

# Опционально: чат для оперативных алертов/смоук-теста (НЕ для уведомлений о заказах —
# те уходят в telegram_chat_id конкретного магазина, см. таблицу shops).
TELEGRAM_ADMIN_CHAT_ID=
# Отдельный бот для админской ленты: статистика (/admin), служебные алерты и
# обращения в поддержку. Создаётся в @BotFather так же, как основной. Если не
# задан, всё это придёт в основной бот и смешается с лентой заказов.
TELEGRAM_ADMIN_BOT_TOKEN=

# --- Опрос WB API ---
POLL_INTERVAL_MINUTES=5
STOCKS_POLL_INTERVAL_MINUTES=5
CARDS_REFRESH_HOUR_MSK=3
TARIFFS_REFRESH_HOUR_MSK=3

# --- Прочее ---
DB_PATH=./data/wbnotify.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Магазины больше НЕ настраиваются здесь. Пользователи подключают свои WB-токены
# сами через команду /addshop в Telegram — токены хранятся зашифрованными в БД
# (таблица shops), а не в .env.
