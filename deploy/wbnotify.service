[Unit]
Description=wb-notify-bot — уведомления о заказах Wildberries в Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wbnotify
WorkingDirectory=/opt/wb-notify-bot
Environment=PYTHONUNBUFFERED=1
# Часовой пояс процесса — МСК: WB отдаёт все даты в московском времени, и
# суточные расписания (сброс счётчиков [#N], обновление карточек в 3:00) должны
# совпадать с ним же.
Environment=TZ=Europe/Moscow
ExecStart=/opt/wb-notify-bot/.venv/bin/python scripts/run_scheduler.py

# Перезапуск при любом падении и после перезагрузки сервера. RestartSec защищает
# от бесконечного цикла рестартов, если процесс падает сразу на старте
# (например, при неверном .env).
Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wbnotify

# Базовое ограничение прав: сервису нужно писать только в свой каталог с БД.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/wb-notify-bot/data

[Install]
WantedBy=multi-user.target
